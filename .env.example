# ============================================
#   CONFIGURATION SYSTÈME D'AFFILIATION
#   Copie ce fichier en .env et remplis les valeurs
#   IMPORTANT : ne jamais commiter le fichier .env !
# ============================================

# --- OBLIGATOIRE --- Claude AI (cerveau du système)
# Obtenir sur : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# --- OBLIGATOIRE --- Amazon Associates (tes commissions)
# Obtenir sur : https://affiliate-program.amazon.com
AMAZON_AFFILIATE_TAG=montag-20

# --- OBLIGATOIRE --- WordPress (ton blog d'affiliation)
# WP_APP_PASSWORD : Tableau de bord → Utilisateurs → Profil → Mots de passe d'application
WP_URL=https://monsite.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- OBLIGATOIRE --- Facebook (portée organique gratuite)
# Obtenir sur : https://developers.facebook.com → Graph API Explorer
FACEBOOK_PAGE_ID=123456789012345
FACEBOOK_PAGE_TOKEN=EAAxxxxxxxxxxxxxxx

# --- OBLIGATOIRE --- Mailchimp (liste email = revenus récurrents)
# Obtenir sur : https://mailchimp.com → Account → Extras → API Keys
# MAILCHIMP_SERVER : la partie "usXX" de ton URL Mailchimp (ex: us14)
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us14
MAILCHIMP_LIST_ID=xxxxxxxxxx
MAILCHIMP_SERVER=us14

# --- OPTIONNEL --- Twitter/X (coûte 100$/mois pour l'API d'écriture)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- OPTIONNEL --- Slack (notifications quand le pipeline tourne)
# Créer un webhook sur : api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/XXXXX/XXXXX
